# ========================================================
# PENGATURAN ENVIRONMENT (REST API GOLANG & SUPABASE)
# Salin file ini menjadi .env lalu isi sesuai kebutuhan
# ========================================================

# Port server REST API
PORT=8080

# Kunci rahasia untuk membuat token login (JWT)
JWT_SECRET=rahasia-kunci-jwt-ukl-super-aman-12345

# Lama waktu kode OTP berlaku (dalam menit)
OTP_EXPIRY_MINUTES=5

# Koneksi ke Database Supabase PostgreSQL
# Format URL: postgresql://postgres:[PASSWORD_SUPABASE_ANDA]@db.xjynkofpazooiiqllfqx.supabase.co:5432/postgres
# Catatan: Jika dikosongkan, aplikasi akan otomatis menggunakan database SQLite lokal (sqlite_local.db) agar langsung bisa dicoba offline!
DATABASE_URL=
